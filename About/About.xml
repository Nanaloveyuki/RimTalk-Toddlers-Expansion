			<displayName>Toddlers</displayName>
			<steamWorkshopUrl>steam://url/CommunityFilePage/2903359152</steamWorkshopUrl>
		</li>
		<li>
			<packageId>brrainz.harmony</packageId>
			<displayName>Harmony</displayName>
			<steamWorkshopUrl>steam://url/CommunityFilePage/2009463077</steamWorkshopUrl>
			<downloadUrl>https://github.com/pardeike/HarmonyRimWorld/releases/latest</downloadUrl>
		</li>
	</modDependencies>

	<loadAfter>
		<li>cj.rimtalk</li>
		<li>cyanobot.toddlers</li>
		<li>brrainz.harmony</li>
		<li>Jaxe.Bubbles</li>
		<li>Nanaloveyuki.IrisMenus</li>
	</loadAfter>

	<incompatibleWith>
		<li>cj.rimtalk.toddlers</li>
	</incompatibleWith>

</ModMetaData>
