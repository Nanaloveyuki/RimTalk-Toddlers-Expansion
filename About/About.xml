<?xml version="1.0" encoding="utf-8"?>
<ModMetaData>

	<packageId>cj.RimtalkToddlersExpansion.continue</packageId>
	<name>RimTalk - Expand Toddlers (Continue)</name>
	<author>changlusss; Nanaloveyuki (Continued)</author>
