<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Version>1.1.2</Version>
    <PlatformTarget>x64</PlatformTarget>
    <OutputPath>../../../1.7/IrisMenus/Assemblies/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <RimWorldDir Condition="'$(RimWorldDir)' == ''">$(RIMWORLD_DIR)</RimWorldDir>
    <IrisMenusAssemblyPath Condition="'$(IrisMenusAssemblyPath)' == ''">$(MSBuildThisFileDirectory)../../../../RimworldMods/iris_menus/1.7/Assemblies/IrisMenus.dll</IrisMenusAssemblyPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../RimTalk_ToddlersExpansion.csproj" Private="false" />
    <Reference Include="Assembly-CSharp" HintPath="$(RimWorldDir)/Assembly-CSharp.dll" Private="false" />
    <Reference Include="UnityStubs" HintPath="$(RimWorldDir)/UnityStubs.dll" Private="false" />
    <Reference Include="IrisMenus" HintPath="$(IrisMenusAssemblyPath)" Private="false" />
  </ItemGroup>
  <Import Project="../../GameRuntimeReferences.targets" />
  <Target Name="CheckIrisMenusReference" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(IrisMenusAssemblyPath)')" Text="Set IrisMenusAssemblyPath to the RimWorld 1.7 IrisMenus.dll." />
  </Target>
</Project>
