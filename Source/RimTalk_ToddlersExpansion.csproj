<Project Sdk="Microsoft.NET.Sdk">

  <!--
    RimTalk Toddlers Expansion (Add-on Mod)
    Build:
      dotnet build -c Release -p:GameVersion=1.7 -p:RimWorldDir="/path/to/RimWorld" -p:HarmonyAssemblyPath="/path/to/Harmony/1.7/Assemblies/0Harmony.dll" -p:ToddlersAssemblyPath="/path/to/Toddlers/1.6/Assemblies/Toddlers.dll"
    Output:
      <ModRoot>\1.7\Assemblies\RimTalk_ToddlersExpansion.dll
  -->

  <PropertyGroup>
    <!-- Defaults -->
    <GameVersion Condition=" '$(GameVersion)' == '' ">1.7</GameVersion>

    <TargetFramework>net10.0</TargetFramework>
    <Version>1.0.2</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <PlatformTarget>x64</PlatformTarget>
    <DefineConstants>$(DefineConstants);V1_7</DefineConstants>

    <RootNamespace>RimTalk_ToddlersExpansion</RootNamespace>
    <AssemblyName>RimTalk_ToddlersExpansion</AssemblyName>

    <OutputPath>..\1.7\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>

    <!-- VSCode/OmniSharp: do not fall back to C# 7.3 -->
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>

    <!-- Mod assemblies: keep outputs clean -->
    <DebugType>portable</DebugType>
    <Deterministic>true</Deterministic>

    <!-- Make it easier to evolve this add-on without blocking builds -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup>
    <RimWorldDir Condition=" '$(RimWorldDir)' == '' ">$(RIMWORLD_DIR)</RimWorldDir>
    <HarmonyAssemblyPath Condition=" '$(HarmonyAssemblyPath)' == '' ">$(HarmonyModDir)/1.7/Assemblies/0Harmony.dll</HarmonyAssemblyPath>
    <ToddlersDir Condition=" '$(ToddlersDir)' == '' ">..\..\Toddlers</ToddlersDir>
    <ToddlersAssemblyName Condition=" '$(ToddlersAssemblyName)' == '' ">Toddlers</ToddlersAssemblyName>
    <ToddlersAssemblyPath Condition=" '$(ToddlersAssemblyPath)' == '' and Exists('$(ToddlersDir)/1.7/Assemblies/$(ToddlersAssemblyName).dll') ">$(ToddlersDir)/1.7/Assemblies/$(ToddlersAssemblyName).dll</ToddlersAssemblyPath>
    <ToddlersAssemblyPath Condition=" '$(ToddlersAssemblyPath)' == '' and Exists('$(ToddlersDir)/1.6/Assemblies/$(ToddlersAssemblyName).dll') ">$(ToddlersDir)/1.6/Assemblies/$(ToddlersAssemblyName).dll</ToddlersAssemblyPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp" HintPath="$(RimWorldDir)/Assembly-CSharp.dll" Private="false" />
    <Reference Include="UnityStubs" HintPath="$(RimWorldDir)/UnityStubs.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(HarmonyAssemblyPath)" Private="false" />
    <Reference Include="Toddlers" HintPath="$(ToddlersAssemblyPath)" Private="false" />
  </ItemGroup>

  <!-- Native Toddlers builds can reference CoreLib directly, so use the matching game runtime when available. -->
  <Target Name="UseGameRuntimeReferences" BeforeTargets="CoreCompile" Condition="Exists('$(RimWorldDir)/System.Private.CoreLib.dll')">
    <ItemGroup>
      <SdkFrameworkReferences Include="@(ReferencePathWithRefAssemblies)"
                              Condition="'%(ReferencePathWithRefAssemblies.FrameworkReferenceName)' == 'Microsoft.NETCore.App' and Exists('$(RimWorldDir)/%(ReferencePathWithRefAssemblies.Filename)%(ReferencePathWithRefAssemblies.Extension)')" />
      <ReferencePathWithRefAssemblies Remove="@(SdkFrameworkReferences)" />
      <ReferencePathWithRefAssemblies Include="@(SdkFrameworkReferences->'$(RimWorldDir)/%(Filename)%(Extension)');$(RimWorldDir)/System.Private.*.dll" />
    </ItemGroup>
  </Target>

  <Target Name="CheckRimWorldReferences" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(GameVersion)' != '1.7'" Text="Source builds target RimWorld 1.7. Use the original assemblies shipped in 1.6/Assemblies for RimWorld 1.6." />
    <Error Condition="!Exists('$(RimWorldDir)/Assembly-CSharp.dll') or !Exists('$(RimWorldDir)/UnityStubs.dll')" Text="Set RimWorldDir to the RimWorld 1.7 game root containing Assembly-CSharp.dll and UnityStubs.dll." />
    <Error Condition="!Exists('$(HarmonyAssemblyPath)')" Text="Set HarmonyAssemblyPath to Harmony's 1.7/Assemblies/0Harmony.dll." />
    <Error Condition="!Exists('$(ToddlersAssemblyPath)')" Text="Set ToddlersDir to the installed Toddlers mod, or set ToddlersAssemblyPath to its Toddlers.dll. The 1.6 assembly is supported as a build reference." />
  </Target>

  <!-- Prompt templates (optional): embed into the assembly to avoid file path issues -->
  <ItemGroup Condition="Exists('promptoverride')">
    <EmbeddedResource Include="promptoverride\templates\**\*.txt" />
  </ItemGroup>

</Project>
